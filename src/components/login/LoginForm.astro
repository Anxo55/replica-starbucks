<main class="min-h-screen">
    
    <div class="flex min-h-screen">

    <div class="w-1/2 items-center flex flex-col gap-8 mb-10 mt-4">
        <span class="flex mb-2">
                    <a href="/" class="flex items-center">
                        <svg aria-hidden="true" class="valign-middle w-8 h-8 " focusable="false" preserveAspectRatio="xMidYMid meet" viewBox="0 0 24 24" style="overflow: visible; fill: currentcolor;"><path d="M15.098 5.78c.292-.293.292-.767 0-1.06-.293-.293-.768-.293-1.06 0L7.62 11.137c-.293.293-.293.768 0 1.06l6.52 6.52c.292.293.767.293 1.06 0 .293-.293.293-.768 0-1.06l-5.99-5.99L15.1 5.78z"></path></svg>
                        <span>Volver</span>
                    </a>
        </span>

        <div>
            <h2 class="text-2xl mb-6">Iniciar sesión</h2>

            <p class="text-gray-400 text-sm mb-8">Los campos obligatorios están marcados con un asterisco</p>

            <div class="flex flex-col">
                <input type="email" name="email" id="email" placeholder="Introduce tu correo electrónico" class="border-2 rounded-2xl border-gray-400 mb-6">
                <input type="password" name="password" id="password" placeholder="Introducir contraseña" class="border-2 rounded-2xl border-gray-400 mb-10">
            </div>

            <p class="text-green-700 underline mb-8">Has olvidado tu contraseña?</p>


            <button type="button" class="text-white border-2 rounded-2xl h-10 w-30 border-green-800 bg-green-800 mb-8">Iniciar sesión</button>

            <p>Nuevo en Starbucks? <span><a href="/register" class="text-green-700 underline">Crea una cuenta</a></span> </p>
        </div>
    </div>

    <div class="w-1/2">
        <img alt="" loading="lazy" decoding="async" data-nimg="fill" class="w-full h-full object-cover" sizes="100vw" srcset="/sidebar-image-register.webp" >    </div>
    </div>
</main>